{
  "name": "quiz-bot",
  "version": "1.0.0",
  "description": "Quiz bot backend scaffold",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx  src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "quiz",
    "bot",
    "typescript"
  ],
  "author": "Doston Sulaymon",
  "license": "MIT",
  "dependencies": {
    "@sentry/node": "^10.43.0",
    "arabic-reshaper": "^1.1.0",
    "axios": "^1.9.0",
    "bidi-js": "^1.0.3",
    "dotenv": "^16.4.7",
    "grammy": "^1.36.3",
    "ioredis": "^5.6.1",
    "mongoose": "^8.13.2",
    "nanoid": "^5.1.6",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.18.0",
    "puppeteer": "^24.39.1",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/pdfkit": "^0.17.5",
    "@vitest/coverage-v8": "^3.2.4",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.2.4"
  }

# =============================================================================
# ai-quiz — example environment file
#
# Copy to .env and fill in your own values:   cp .env.example .env
#
# Every variable below is read by the code. Placeholders only — never commit
# a real token, API key, connection string, or Telegram user id.
#
# Comments always sit on their own line: a trailing "#" after a value is
# treated as part of the value by some dotenv parsers.
# =============================================================================


# -----------------------------------------------------------------------------
# Core (required)
# -----------------------------------------------------------------------------

# Telegram bot token from @BotFather.
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Runtime environment. One of: development | test | production
# In non-production, invalid session state transitions throw instead of warning.
NODE_ENV=development

# MongoDB connection string.
# Local:  mongodb://localhost:27017/quizbot
# Docker: mongodb://mongo:27017/quizbot
MONGODB_URI=mongodb://localhost:27017/quizbot

# Redis connection string.
# Local:  redis://localhost:6379
# Docker: redis://redis:6379
REDIS_URL=redis://localhost:6379


# -----------------------------------------------------------------------------
# Core (optional)
# -----------------------------------------------------------------------------

# Bot username used to build t.me deep links.
# Falls back to the username reported by Telegram (ctx.me.username) when empty.
BOT_USERNAME=your_bot_username

# Numeric Telegram user id that bypasses all rate limits and the concurrent
# test-session cap. Leave empty to disable.
# Put your own id here in .env only — never in this example file.
SUPER_ADMIN_ID=

# Sentry DSN for error tracking. Leave empty to disable Sentry entirely.
# Format: https://<key>@<org>.ingest.sentry.io/<project_id>
SENTRY_DSN=


# -----------------------------------------------------------------------------
# Health / metrics HTTP server
# -----------------------------------------------------------------------------

# Port serving GET /health and GET /metrics.
# The code default is 4334, but the Dockerfile HEALTHCHECK and the
# docker-compose port mapping both expect 3000.
HEALTH_CHECK_PORT=3000

# Overrides HEALTH_CHECK_PORT when set. Leave commented out unless your host
# injects a PORT variable (common on PaaS platforms).
# PORT=3000


# -----------------------------------------------------------------------------
# AI providers
# -----------------------------------------------------------------------------

# Primary provider. One of: claude | gemini | ollama
# Its key/model pair below becomes required at startup.
AI_PROVIDER=gemini

# Comma-separated fallback order. A provider is only instantiated when its
# credentials are present, so filling in several enables automatic fallback.
AI_PROVIDER_ORDER=claude,gemini,ollama

# Per-request timeout for every AI provider, in milliseconds.
AI_TIMEOUT_MS=120000

# --- Anthropic Claude (required if AI_PROVIDER=claude) ---

CLAUDE_API_KEY=your_claude_api_key_here
CLAUDE_MODEL=claude-sonnet-4-5

# --- Google Gemini (required if AI_PROVIDER=gemini) ---

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# --- Ollama, local models (required if AI_PROVIDER=ollama) ---

# Use http://host.docker.internal:11434 when the bot runs inside Docker.
OLLAMA_BASE_URL=http://localhost:11434

# Text-only in this codebase: PDFs are extracted locally before the request,
# and image uploads are rejected.
OLLAMA_MODEL=llama3.2


# -----------------------------------------------------------------------------
# Limits (all required, must be positive numbers)
# -----------------------------------------------------------------------------

# Upper bound for the custom question-count prompt.
MAX_QUESTIONS_PER_TEST=100

# Maximum accepted upload size for PDFs and images, in megabytes.
MAX_FILE_SIZE_MB=20

# Per-user AI generations allowed per rolling hour.
RATE_LIMIT_GENERATIONS_PER_HOUR=5

# Per-user AI generations allowed per rolling 24 hours.
RATE_LIMIT_DAILY_MAX=20

# Note: the cap of 3 concurrent test sessions and its 6-hour TTL are
# compile-time constants in src/bot/middlewares/rateLimitMiddleware.ts,
# not environment variables. Setting them here would have no effect.


# -----------------------------------------------------------------------------
# Session lifetimes (optional)
# -----------------------------------------------------------------------------

# TTL for grammY session keys in Redis. Default: 604800 (7 days).
SESSION_TTL_SECONDS=604800

# Age after which an active group session is marked abandoned by the hourly
# cleanup job, in milliseconds. Default: 1800000 (30 minutes).
STALE_GROUP_SESSION_TTL_MS=1800000

# Age after which an unfinished private test session is marked abandoned,
# in milliseconds. Default: 86400000 (24 hours).
ABANDONED_SESSION_TTL_MS=86400000

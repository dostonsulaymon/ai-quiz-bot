# === Bot ===
BOT_TOKEN=          # From @BotFather
NODE_ENV=development # Options: development | test | production

# === AI Provider ===
AI_PROVIDER=claude  # Options: claude | gemini | ollama
CLAUDE_API_KEY=     # Required if AI_PROVIDER=claude
CLAUDE_MODEL=claude-haiku-4-5-20251001   # Recommended: haiku for cost
GEMINI_API_KEY=     # Required if AI_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash            # Recommended
OLLAMA_BASE_URL=http://localhost:11434   # Required if AI_PROVIDER=ollama
OLLAMA_MODEL=llama3.2-vision:11b

# === Database ===
MONGODB_URI=mongodb://mongo:27017/quizbot
REDIS_URL=redis://redis:6379

# === Limits ===
MAX_QUESTIONS_PER_TEST=50
MAX_FILE_SIZE_MB=20
RATE_LIMIT_GENERATIONS_PER_HOUR=5
RATE_LIMIT_DAILY_MAX=20
